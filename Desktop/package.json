{
  "name": "whattoplaytogether-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "WhatToPlayTogether — inicia sesión con Steam para encontrar juegos en común",
  "author": "WhatToPlayTogether",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node ./scripts/ensure-electron.cjs",
    "release:win": "electron-vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.whattoplaytogether.desktop",
    "productName": "WhatToPlayTogether",
    "directories": {
      "output": "Ejecutable"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "executableName": "WhatToPlayTogether",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "WhatToPlayTogether-${version}.exe"
    }
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
